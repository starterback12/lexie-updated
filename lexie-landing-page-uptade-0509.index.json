<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lexie — Inteligência que conecta. Resultados que transformam.</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=general-sans@500,600,700,800&display=swap">
<style>
:root{
  --black:#0b0b0d;
  --black-2:#111114;
  --white:#f6f3ee;
  --white-dim:rgba(246,243,238,.62);
  --white-faint:rgba(246,243,238,.38);
  --violet:#7b61ff;
  --violet-soft:#a78bfa;
  --violet-dim:rgba(123,97,255,.14);
  --line:rgba(246,243,238,.1);
  --line-soft:rgba(246,243,238,.06);
  --mono:'JetBrains Mono',monospace;
  --sans:'General Sans','Inter',sans-serif;
  --body:'Inter',sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
@media (prefers-reduced-motion: reduce){
  html{scroll-behavior:auto;}
  *{animation-duration:.01ms !important;animation-iteration-count:1 !important;transition-duration:.01ms !important;}
}
body{
  background:var(--black);
  color:var(--white);
  font-family:var(--body);
  line-height:1.5;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
a{color:inherit;text-decoration:none;}
img,svg{display:block;max-width:100%;}
.wrap{max-width:1180px;margin:0 auto;padding:0 32px;}
@media (max-width:720px){.wrap{padding:0 20px;}}

::selection{background:var(--violet);color:var(--white);}

a:focus-visible, button:focus-visible{
  outline:2px solid var(--violet-soft);
  outline-offset:3px;
  border-radius:4px;
}

/* ---------- Nav ---------- */
header{
  position:fixed;top:0;left:0;right:0;z-index:100;
  border-bottom:1px solid var(--line-soft);
  background:rgba(11,11,13,.72);
  backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);
}
nav{
  display:flex;align-items:center;justify-content:space-between;
  height:72px;
}
.logo{
  font-family:var(--sans);font-weight:700;font-size:20px;letter-spacing:-.02em;
  display:flex;align-items:center;gap:9px;
}
.logo-mark{
  width:20px;height:20px;border-radius:6px;
  background:linear-gradient(135deg,var(--violet),var(--violet-soft));
  flex-shrink:0;
}
.logo-tagline{
  font-family:var(--body);font-weight:400;font-size:12.5px;color:var(--white-faint);
  margin-left:14px;padding-left:14px;border-left:1px solid var(--line);letter-spacing:0;
}
@media (max-width:900px){.logo-tagline{display:none;}}
.nav-links{display:flex;gap:36px;font-size:14.5px;color:var(--white-dim);}
.nav-links a:hover{color:var(--white);}
@media (max-width:820px){.nav-links{display:none;}}
.btn{
  display:inline-flex;align-items:center;gap:8px;
  padding:11px 22px;border-radius:100px;
  font-family:var(--sans);font-weight:600;font-size:14px;
  border:1px solid transparent;cursor:pointer;
  transition:transform .18s ease, background .18s ease, border-color .18s ease;
  white-space:nowrap;
}
.btn-primary{background:var(--white);color:var(--black);}
.btn-primary:hover{transform:translateY(-1px);background:var(--violet-soft);}
.btn-ghost{border-color:var(--line);color:var(--white);}
.btn-ghost:hover{border-color:var(--white-dim);}

/* ---------- Hero ---------- */
.hero{
  padding:168px 0 96px;
  position:relative;
}
.hero-grid{
  display:grid;grid-template-columns:1.05fr .95fr;gap:64px;align-items:center;
}
@media (max-width:900px){.hero-grid{grid-template-columns:1fr;gap:56px;}}
.eyebrow{
  font-family:var(--mono);font-size:12.5px;letter-spacing:.08em;text-transform:uppercase;
  color:var(--violet-soft);display:flex;align-items:center;gap:10px;margin-bottom:22px;
}
.eyebrow::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--violet-soft);box-shadow:0 0 12px var(--violet-soft);}
h1.headline{
  font-family:var(--sans);font-weight:700;letter-spacing:-.03em;
  font-size:clamp(36px,5vw,58px);line-height:1.05;margin-bottom:22px;
}
h1.headline em{font-style:normal;color:var(--violet-soft);}
.sub{
  font-size:17.5px;color:var(--white-dim);max-width:480px;margin-bottom:34px;line-height:1.6;
}
.hero-cta{display:flex;gap:14px;margin-bottom:52px;flex-wrap:wrap;}
.stat-row{display:flex;gap:36px;flex-wrap:wrap;border-top:1px solid var(--line-soft);padding-top:28px;}
.stat b{
  display:block;font-family:var(--sans);font-weight:700;font-size:26px;letter-spacing:-.02em;
}
.stat span{font-family:var(--mono);font-size:11.5px;color:var(--white-faint);text-transform:uppercase;letter-spacing:.05em;}

/* phone mockup - signature element */
.phone-stage{display:flex;justify-content:center;position:relative;}
.phone{
  width:320px;border-radius:34px;
  background:linear-gradient(180deg,#17171b,#0d0d10);
  border:1px solid var(--line);
  padding:14px;
  box-shadow:0 40px 100px -30px rgba(123,97,255,.25), 0 0 0 1px rgba(255,255,255,.02);
  position:relative;
}
.phone::before{
  content:'';position:absolute;inset:-40px;
  background:radial-gradient(circle at 50% 30%,rgba(123,97,255,.18),transparent 65%);
  z-index:-1;
}
.phone-screen{
  background:#0f0f12;border-radius:24px;overflow:hidden;height:520px;display:flex;flex-direction:column;
}
.phone-topbar{
  display:flex;align-items:center;gap:10px;padding:16px 16px 12px;border-bottom:1px solid var(--line-soft);
}
.phone-avatar{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--violet),var(--violet-soft));flex-shrink:0;}
.phone-name{font-family:var(--sans);font-weight:600;font-size:13.5px;}
.phone-status{font-family:var(--mono);font-size:10px;color:#5ee6a8;display:flex;align-items:center;gap:5px;}
.phone-status::before{content:'';width:5px;height:5px;border-radius:50%;background:#5ee6a8;}
.phone-body{flex:1;padding:16px;display:flex;flex-direction:column;gap:10px;overflow:hidden;}
.bubble{
  max-width:78%;padding:10px 14px;border-radius:16px;font-size:13px;line-height:1.45;
  opacity:0;transform:translateY(8px);animation:bubbleIn .5s ease forwards;
}
.bubble.in{background:var(--white);color:var(--black);align-self:flex-start;border-bottom-left-radius:4px;}
.bubble.out{background:var(--violet);color:var(--white);align-self:flex-end;border-bottom-right-radius:4px;}
@keyframes bubbleIn{to{opacity:1;transform:translateY(0);}}
.b1{animation-delay:.3s;}.b2{animation-delay:1s;}.b3{animation-delay:1.9s;}.b4{animation-delay:2.7s;}.b5{animation-delay:3.6s;}
.typing-dots{align-self:flex-start;background:var(--white);border-radius:16px;border-bottom-left-radius:4px;padding:11px 14px;display:flex;gap:4px;opacity:0;animation:bubbleIn .4s ease forwards;animation-delay:1.5s;}
.typing-dots span{width:5px;height:5px;border-radius:50%;background:#8a8a90;animation:blink 1s infinite;}
.typing-dots span:nth-child(2){animation-delay:.15s;}
.typing-dots span:nth-child(3){animation-delay:.3s;}
@keyframes blink{0%,60%,100%{opacity:.3;}30%{opacity:1;}}
.phone-input{
  margin:0 16px 16px;padding:12px 14px;border:1px solid var(--line);border-radius:100px;
  font-size:12px;color:var(--white-faint);display:flex;justify-content:space-between;
}

/* ---------- Segments (para qualquer negócio) ---------- */
.segment-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
@media (max-width:820px){.segment-grid{grid-template-columns:repeat(2,1fr);}}
@media (max-width:560px){.segment-grid{grid-template-columns:1fr;}}
.segment-card{
  border:1px solid var(--line);border-radius:16px;padding:26px 24px;background:var(--black-2);
  transition:border-color .2s ease;
}
.segment-card:hover{border-color:var(--white-dim);}
.segment-icon{
  width:36px;height:36px;border-radius:10px;background:var(--violet-dim);
  display:flex;align-items:center;justify-content:center;margin-bottom:16px;color:var(--violet-soft);font-size:16px;
}
.segment-card h3{font-family:var(--sans);font-weight:600;font-size:15.5px;margin-bottom:6px;}
.segment-card p{font-size:13.5px;color:var(--white-faint);line-height:1.5;}

/* ---------- Scenario (cenário real) ---------- */
.scenario{
  border:1px solid var(--line);border-radius:20px;background:var(--black-2);padding:0;overflow:hidden;
  display:grid;grid-template-columns:1.1fr .9fr;margin-top:24px;
}
@media (max-width:820px){.scenario{grid-template-columns:1fr;}}
.scenario-text{padding:40px 42px;display:flex;flex-direction:column;justify-content:center;}
.scenario-text .tag{font-family:var(--mono);font-size:11px;color:#ff8a7a;text-transform:uppercase;letter-spacing:.06em;margin-bottom:14px;display:block;}
.scenario-text h3{font-family:var(--sans);font-weight:600;font-size:20px;margin-bottom:12px;}
.scenario-text p{color:var(--white-dim);font-size:14.5px;line-height:1.6;margin-bottom:16px;}
.scenario-stat{font-family:var(--mono);font-size:12px;color:var(--white-faint);border-top:1px solid var(--line-soft);padding-top:16px;}
.scenario-stat b{color:var(--violet-soft);}
.scenario-log{
  background:#0a0a0c;padding:30px 28px;display:flex;flex-direction:column;gap:10px;justify-content:center;
  border-left:1px solid var(--line);
}
@media (max-width:820px){.scenario-log{border-left:none;border-top:1px solid var(--line);}}
.log-line{display:flex;justify-content:space-between;gap:14px;font-size:13px;padding:9px 0;border-bottom:1px solid var(--line-soft);}
.log-line:last-child{border-bottom:none;}
.log-msg{color:var(--white-dim);}
.log-time{font-family:var(--mono);font-size:11px;color:var(--white-faint);white-space:nowrap;}
.log-line.lost .log-msg{color:#ff8a7a;}
.log-gap{
  text-align:center;font-family:var(--mono);font-size:10.5px;color:var(--white-faint);
  padding:6px 0;letter-spacing:.05em;
}
section{padding:120px 0;}
@media (max-width:720px){section{padding:80px 0;}}
.section-head{max-width:640px;margin-bottom:64px;}
.section-head .eyebrow{margin-bottom:16px;}
h2{
  font-family:var(--sans);font-weight:700;letter-spacing:-.025em;
  font-size:clamp(28px,3.6vw,42px);line-height:1.12;margin-bottom:18px;
}
.section-head p{color:var(--white-dim);font-size:16.5px;line-height:1.65;}

/* ---------- Problem / Interest ---------- */
.problem-strip{
  display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);border-radius:20px;overflow:hidden;
}
@media (max-width:820px){.problem-strip{grid-template-columns:1fr;}}
.problem-card{
  padding:32px 28px;border-right:1px solid var(--line);
}
.problem-card:last-child{border-right:none;}
@media (max-width:820px){.problem-card{border-right:none;border-bottom:1px solid var(--line);}.problem-card:last-child{border-bottom:none;}}
.problem-card .tag{font-family:var(--mono);font-size:11px;color:#ff8a7a;text-transform:uppercase;letter-spacing:.06em;margin-bottom:14px;display:block;}
.problem-card h3{font-family:var(--sans);font-weight:600;font-size:17px;margin-bottom:8px;}
.problem-card p{color:var(--white-dim);font-size:14.5px;line-height:1.55;}

/* flow */
.flow{
  display:flex;align-items:center;gap:0;margin-top:72px;flex-wrap:wrap;justify-content:center;
}
.flow-node{
  padding:14px 20px;border:1px solid var(--line);border-radius:100px;
  font-family:var(--mono);font-size:12.5px;background:var(--black-2);white-space:nowrap;
}
.flow-arrow{color:var(--white-faint);font-size:14px;padding:0 4px;}
@media (max-width:720px){.flow{flex-direction:column;}.flow-arrow{transform:rotate(90deg);padding:6px 0;}}

/* ---------- Slogan banner ---------- */
.slogan-banner{
  text-align:center;padding:60px 0;border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft);
}
.slogan-banner p{
  font-family:var(--sans);font-weight:600;font-size:clamp(22px,3vw,32px);letter-spacing:-.015em;
  max-width:720px;margin:0 auto;line-height:1.3;
}
.slogan-banner p em{font-style:normal;color:var(--violet-soft);}

/* ---------- Voice spotlight ---------- */
.voice-spotlight{
  border:1px solid var(--line);border-radius:20px;background:var(--black-2);overflow:hidden;
  display:grid;grid-template-columns:.95fr 1.05fr;margin-top:16px;
}
@media (max-width:820px){.voice-spotlight{grid-template-columns:1fr;}}
.voice-spotlight-visual{
  background:radial-gradient(circle at 30% 30%,rgba(123,97,255,.22),transparent 60%),#0a0a0c;
  padding:44px;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:18px;
  border-right:1px solid var(--line);
}
@media (max-width:820px){.voice-spotlight-visual{border-right:none;border-bottom:1px solid var(--line);}}
.call-card{
  background:var(--black-2);border:1px solid var(--line);border-radius:18px;padding:24px 28px;width:100%;max-width:280px;
  display:flex;flex-direction:column;align-items:center;gap:14px;
}
.call-avatar{width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,var(--violet),var(--violet-soft));display:flex;align-items:center;justify-content:center;font-family:var(--sans);font-weight:700;font-size:18px;color:var(--white);}
.call-name{font-family:var(--sans);font-weight:600;font-size:14.5px;}
.call-status{font-family:var(--mono);font-size:11px;color:#5ee6a8;}
.waveform{display:flex;align-items:center;gap:3px;height:24px;}
.waveform span{width:3px;border-radius:2px;background:var(--violet-soft);animation:wave 1.1s ease-in-out infinite;}
.waveform span:nth-child(1){height:40%;animation-delay:0s;}
.waveform span:nth-child(2){height:80%;animation-delay:.1s;}
.waveform span:nth-child(3){height:55%;animation-delay:.2s;}
.waveform span:nth-child(4){height:100%;animation-delay:.3s;}
.waveform span:nth-child(5){height:65%;animation-delay:.4s;}
.waveform span:nth-child(6){height:35%;animation-delay:.5s;}
.waveform span:nth-child(7){height:75%;animation-delay:.6s;}
@keyframes wave{0%,100%{transform:scaleY(.5);}50%{transform:scaleY(1);}}
.call-confirm{
  width:100%;border-top:1px solid var(--line-soft);padding-top:12px;margin-top:2px;
  font-family:var(--mono);font-size:10.5px;color:var(--white-faint);text-align:center;
}
.voice-spotlight-text{padding:44px 42px;display:flex;flex-direction:column;justify-content:center;}
.voice-badge{
  display:inline-flex;align-items:center;gap:7px;font-family:var(--mono);font-size:11px;
  color:var(--violet-soft);background:var(--violet-dim);border-radius:100px;padding:6px 14px;
  margin-bottom:18px;width:fit-content;text-transform:uppercase;letter-spacing:.05em;
}
.voice-spotlight-text h3{font-family:var(--sans);font-weight:700;font-size:25px;letter-spacing:-.015em;margin-bottom:14px;line-height:1.2;}
.voice-spotlight-text p{color:var(--white-dim);font-size:15px;line-height:1.6;margin-bottom:20px;}
.voice-list{list-style:none;font-size:14px;color:var(--white-dim);}
.voice-list li{padding:9px 0;padding-left:24px;position:relative;border-top:1px solid var(--line-soft);}
.voice-list li:first-child{border-top:none;}
.voice-list li::before{content:'✓';position:absolute;left:0;color:var(--violet-soft);font-weight:600;}

/* ---------- Proactive call mini-dialogue ---------- */
.proactive-call{
  margin-top:20px;border:1px solid var(--line);border-radius:20px;background:var(--black-2);
  padding:36px 40px;display:grid;grid-template-columns:1fr 1fr;gap:36px;align-items:center;
}
@media (max-width:820px){.proactive-call{grid-template-columns:1fr;}}
.proactive-call-text h3{font-family:var(--sans);font-weight:600;font-size:18px;margin-bottom:10px;line-height:1.3;}
.proactive-call-text p{color:var(--white-dim);font-size:14.5px;line-height:1.6;}
.mini-chat{display:flex;flex-direction:column;gap:10px;}
.mini-bubble{max-width:82%;padding:11px 15px;border-radius:16px;font-size:13.5px;line-height:1.45;}
.mini-bubble.in{background:#1a1a1e;border:1px solid var(--line);align-self:flex-start;border-bottom-left-radius:4px;}
.mini-bubble.out{background:var(--violet);color:var(--white);align-self:flex-end;border-bottom-right-radius:4px;}

/* ---------- Handoff (humano) ---------- */
.handoff{
  display:flex;align-items:center;gap:28px;border:1px solid var(--line);border-radius:20px;
  padding:36px 40px;background:var(--black-2);
}
@media (max-width:700px){.handoff{flex-direction:column;align-items:flex-start;gap:18px;}}
.handoff-icon{
  width:52px;height:52px;border-radius:14px;background:var(--violet-dim);flex-shrink:0;
  display:flex;align-items:center;justify-content:center;color:var(--violet-soft);font-size:22px;
}
.handoff-text h3{font-family:var(--sans);font-weight:600;font-size:17px;margin-bottom:6px;}
.handoff-text p{color:var(--white-dim);font-size:14.5px;line-height:1.55;max-width:640px;}

/* ---------- Feature cards (Desire) ---------- */
.feature-grid{
  display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);
  border:1px solid var(--line);border-radius:20px;overflow:hidden;
}
@media (max-width:900px){.feature-grid{grid-template-columns:repeat(2,1fr);}}
@media (max-width:600px){.feature-grid{grid-template-columns:1fr;}}
.feature-card{
  background:var(--black);padding:30px 26px;transition:background .2s ease;
}
.feature-card:hover{background:var(--black-2);}
.feature-icon{
  width:38px;height:38px;border-radius:10px;background:var(--violet-dim);
  display:flex;align-items:center;justify-content:center;margin-bottom:18px;color:var(--violet-soft);
}
.feature-card h3{font-family:var(--sans);font-weight:600;font-size:16px;margin-bottom:10px;}
.feature-card h3.impact{font-size:17px;line-height:1.35;margin-bottom:10px;}
.feature-card p.impact-sub{font-size:13.5px;color:var(--white-dim);line-height:1.55;}
.feature-card ul{list-style:none;color:var(--white-dim);font-size:13.5px;line-height:1.9;}
.feature-card ul li::before{content:'—';color:var(--white-faint);margin-right:8px;}

/* ---------- Differentials ---------- */
.diff-list{display:grid;grid-template-columns:repeat(2,1fr);gap:16px 40px;}
@media (max-width:700px){.diff-list{grid-template-columns:1fr;}}
.diff-item{display:flex;align-items:flex-start;gap:14px;padding:18px 0;border-bottom:1px solid var(--line-soft);}
.diff-check{
  width:22px;height:22px;border-radius:50%;background:var(--violet-dim);color:var(--violet-soft);
  display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;font-size:12px;
}
.diff-item span{font-size:15px;color:var(--white-dim);}
.diff-item strong{color:var(--white);font-weight:600;}

/* ---------- Dashboard mockup ---------- */
.dash{
  border:1px solid var(--line);border-radius:20px;background:var(--black-2);padding:28px;
  position:relative;overflow:hidden;
}
.dash::before{content:'';position:absolute;inset:-60px;background:radial-gradient(circle at 80% 0%,rgba(123,97,255,.12),transparent 60%);z-index:0;}
.dash-inner{position:relative;z-index:1;}
.dash-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;}
.dash-title{font-family:var(--sans);font-weight:600;font-size:15px;}
.dash-period{font-family:var(--mono);font-size:11px;color:var(--white-faint);}
.dash-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px;}
@media (max-width:800px){.dash-grid{grid-template-columns:repeat(2,1fr);}}
.dash-card{border:1px solid var(--line);border-radius:14px;padding:18px;background:var(--black);}
.dash-card span{font-family:var(--mono);font-size:10.5px;color:var(--white-faint);text-transform:uppercase;letter-spacing:.05em;}
.dash-card b{display:block;font-family:var(--sans);font-size:22px;font-weight:700;margin-top:8px;}
.dash-card .delta{font-family:var(--mono);font-size:11px;color:#5ee6a8;margin-top:4px;display:block;}
.dash-chart{border:1px solid var(--line);border-radius:14px;padding:20px;background:var(--black);height:160px;display:flex;align-items:flex-end;gap:8px;}
.dash-chart .bar{flex:1;background:linear-gradient(180deg,var(--violet-soft),var(--violet));border-radius:4px 4px 0 0;opacity:.85;}

/* ---------- Pricing ---------- */
.pricing-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;align-items:stretch;}
@media (max-width:980px){.pricing-grid{grid-template-columns:repeat(2,1fr);}}
@media (max-width:600px){.pricing-grid{grid-template-columns:1fr;}}
.plan{
  border:1px solid var(--line);border-radius:20px;padding:30px 26px;display:flex;flex-direction:column;
  background:var(--black-2);position:relative;
}
.plan.featured{border-color:var(--violet-soft);background:linear-gradient(180deg,rgba(123,97,255,.1),var(--black-2) 40%);}
.plan-badge{
  position:absolute;top:-13px;left:26px;background:var(--violet-soft);color:var(--black);
  font-family:var(--mono);font-size:10.5px;font-weight:500;padding:5px 12px;border-radius:100px;letter-spacing:.03em;
}
.plan-name{font-family:var(--sans);font-weight:600;font-size:16px;margin-bottom:6px;}
.plan-desc{font-size:13px;color:var(--white-faint);margin-bottom:20px;min-height:34px;}
.plan-price{font-family:var(--sans);font-weight:700;font-size:32px;margin-bottom:2px;}
.plan-price span{font-family:var(--body);font-weight:400;font-size:13px;color:var(--white-faint);}
.plan hr{border:none;border-top:1px solid var(--line-soft);margin:22px 0;}
.plan-features{list-style:none;font-size:13.5px;color:var(--white-dim);flex:1;}
.plan-features li{padding:7px 0;padding-left:20px;position:relative;line-height:1.4;}
.plan-features li::before{content:'✓';position:absolute;left:0;color:var(--violet-soft);font-weight:600;}
.plan .btn{width:100%;justify-content:center;margin-top:24px;}
.plan-quota{
  text-align:center;font-family:var(--mono);font-size:10.5px;color:var(--white-faint);
  margin-top:12px;letter-spacing:.01em;
}

/* ---------- Social proof ---------- */
.proof-row{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:30px;padding:36px 0;border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft);}
.proof-logo{font-family:var(--mono);font-size:13px;color:var(--white-faint);letter-spacing:.03em;}
.testimonial{margin-top:56px;max-width:680px;}
.testimonial p{font-family:var(--sans);font-size:22px;font-weight:500;line-height:1.4;letter-spacing:-.01em;margin-bottom:20px;}
.testimonial .who{font-family:var(--mono);font-size:12.5px;color:var(--white-faint);}

/* ---------- FAQ ---------- */
.faq-item{border-bottom:1px solid var(--line-soft);}
.faq-q{
  width:100%;background:none;border:none;color:var(--white);text-align:left;
  padding:22px 0;display:flex;justify-content:space-between;align-items:center;
  font-family:var(--sans);font-size:16px;font-weight:600;cursor:pointer;
}
.faq-q .plus{font-size:18px;color:var(--white-faint);transition:transform .25s ease;font-weight:400;}
.faq-item.open .plus{transform:rotate(45deg);}
.faq-a{max-height:0;overflow:hidden;transition:max-height .3s ease;}
.faq-a p{padding-bottom:22px;color:var(--white-dim);font-size:14.5px;line-height:1.65;max-width:640px;}

/* ---------- Final CTA ---------- */
.final-cta{
  text-align:center;border:1px solid var(--line);border-radius:28px;padding:80px 32px;position:relative;overflow:hidden;
}
.final-cta::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 50% 0%,rgba(123,97,255,.2),transparent 60%);}
.final-cta h2{max-width:640px;margin:0 auto 18px;position:relative;}
.final-cta p{color:var(--white-dim);max-width:480px;margin:0 auto 36px;position:relative;font-size:16.5px;}
.final-cta .btn{position:relative;padding:15px 34px;font-size:15px;}

/* ---------- Footer ---------- */
footer{border-top:1px solid var(--line-soft);padding:48px 0;}
.foot-row{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:20px;}
.foot-links{display:flex;gap:28px;font-size:13.5px;color:var(--white-faint);}
.foot-links a:hover{color:var(--white);}
.foot-copy{font-family:var(--mono);font-size:12px;color:var(--white-faint);}

/* reveal on scroll */
.reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease, transform .7s ease;}
.reveal.visible{opacity:1;transform:translateY(0);}
</style>
</head>
<body>

<header>
  <div class="wrap nav">
    <div class="logo"><span class="logo-mark"></span>Lexie<span class="logo-tagline">Inteligência que conecta. Resultados que transformam.</span></div>
    <div class="nav-links">
      <a href="#segmentos">Para quem</a>
      <a href="#como-funciona">Como funciona</a>
      <a href="#recursos">Recursos</a>
      <a href="#planos">Planos</a>
      <a href="#faq">FAQ</a>
    </div>
    <a href="#planos" class="btn btn-primary">Solicitar demonstração</a>
  </div>
</header>

<main>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1 class="headline">Nenhuma conversa <em>fica parada.</em></h1>
        <p class="sub">A Lexie mantém seu atendimento sempre em movimento no WhatsApp — respondendo, agendando e conduzindo cada contato, para qualquer tipo de negócio, a qualquer hora do dia.</p>
        <div class="hero-cta">
          <a href="#planos" class="btn btn-primary">Solicitar demonstração</a>
          <a href="#como-funciona" class="btn btn-ghost">Ver como funciona</a>
        </div>
        <div class="stat-row">
          <div class="stat"><b>&lt;3s</b><span>Tempo de resposta</span></div>
          <div class="stat"><b>24/7</b><span>Disponibilidade</span></div>
          <div class="stat"><b>−38%</b><span>Contatos perdidos</span></div>
          <div class="stat"><b>+2,4x</b><span>Conversões</span></div>
        </div>
      </div>

      <div class="phone-stage">
        <div class="phone">
          <div class="phone-screen">
            <div class="phone-topbar">
              <div class="phone-avatar"></div>
              <div>
                <div class="phone-name">Vitalis</div>
                <div class="phone-status">Lexie online</div>
              </div>
            </div>
            <div class="phone-body">
              <div class="bubble in b1">Oi! Preciso remarcar meu horário de quinta 😕</div>
              <div class="typing-dots"><span></span><span></span><span></span></div>
              <div class="bubble out b2">Sem problema! Encontrei seu horário com Marina às 15h. Prefere outro dia essa semana ou a próxima?</div>
              <div class="bubble in b3">Sexta de manhã seria ótimo</div>
              <div class="bubble out b4">Tenho 9h ou 10h30 disponíveis na sexta. Qual prefere?</div>
              <div class="bubble in b5">9h está perfeito!</div>
            </div>
            <div class="phone-input"><span>Reagendado automaticamente</span><span>✓✓</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SEGMENTS -->
  <section id="segmentos" style="padding-top:0;">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="eyebrow">Para qualquer negócio</div>
        <h2>Se o seu atendimento acontece no WhatsApp, a Lexie se encaixa</h2>
        <p>Ela se adapta ao vocabulário, ao fluxo e às regras do seu tipo de negócio — não é um script genérico.</p>
      </div>
      <div class="segment-grid reveal">
        <div class="segment-card"><div class="segment-icon">◐</div><h3>Clínicas & saúde</h3><p>Agendamento, remarcação e lembretes de consulta.</p></div>
        <div class="segment-card"><div class="segment-icon">◇</div><h3>Salões & estética</h3><p>Marcação de horário e confirmação automática.</p></div>
        <div class="segment-card"><div class="segment-icon">▦</div><h3>Imobiliárias</h3><p>Qualificação de interessados e agendamento de visitas.</p></div>
        <div class="segment-card"><div class="segment-icon">◈</div><h3>Varejo & e-commerce</h3><p>Dúvidas de produto, status de pedido e recuperação de carrinho.</p></div>
        <div class="segment-card"><div class="segment-icon">◑</div><h3>Serviços profissionais</h3><p>Triagem de contato, orçamento e follow-up automático.</p></div>
        <div class="segment-card"><div class="segment-icon">◔</div><h3>Educação</h3><p>Matrículas, dúvidas de alunos e lembretes de aula.</p></div>
      </div>
    </div>
  </section>

  <!-- INTEREST / PROBLEM -->
  <section id="como-funciona">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="eyebrow">O problema</div>
        <h2>Todo negócio perde clientes antes mesmo do primeiro contato</h2>
        <p>Não por falta de qualidade no que você oferece — mas por atrito no atendimento. E esse atrito custa caro, todos os dias.</p>
      </div>

      <div class="problem-strip reveal">
        <div class="problem-card">
          <span class="tag">Sobrecarga</span>
          <h3>Atendimento sobrecarregado</h3>
          <p>Uma pessoa tentando responder ligação, WhatsApp e cliente presencial ao mesmo tempo — algo sempre espera.</p>
        </div>
        <div class="problem-card">
          <span class="tag">Demora</span>
          <h3>Resposta lenta demais</h3>
          <p>Um cliente que espera 20 minutos por uma resposta já está conversando com o concorrente.</p>
        </div>
        <div class="problem-card">
          <span class="tag">Rastreio</span>
          <h3>Tráfego pago sem rastreio exato</h3>
          <p>O anúncio traz o clique certo — mas assim que a conversa cai no WhatsApp, fica difícil saber quantos desses contatos viraram venda ou agendamento de verdade.</p>
        </div>
      </div>

      <div class="scenario reveal">
        <div class="scenario-text">
          <span class="tag">Um cenário comum</span>
          <h3>A mensagem que ficou esperando até de manhã</h3>
          <p>Sexta, 22h47. Alguém pronto para fechar negócio manda uma última pergunta antes de decidir. Ninguém responde. Às 9h do dia seguinte, a resposta chega — mas ele já resolveu com quem falou primeiro.</p>
          <div class="scenario-stat">Contatos que chegam fora do horário comercial raramente <b>esperam até o dia seguinte</b> para decidir.</div>
        </div>
        <div class="scenario-log">
          <div class="log-line"><span class="log-msg">"Vocês têm horário pra amanhã?"</span><span class="log-time">21:14</span></div>
          <div class="log-line"><span class="log-msg">"To decidindo entre vocês e outra opção"</span><span class="log-time">22:31</span></div>
          <div class="log-line lost"><span class="log-msg">"Alguém aí?"</span><span class="log-time">22:47</span></div>
          <div class="log-gap">— 11 horas sem resposta —</div>
          <div class="log-line"><span class="log-msg">"Bom dia! Posso ajudar?"</span><span class="log-time">09:02</span></div>
          <div class="log-line lost"><span class="log-msg">"Já resolvi em outro lugar, obrigado"</span><span class="log-time">09:05</span></div>
        </div>
      </div>

      <div class="flow reveal">
        <div class="flow-node">Anúncio</div><span class="flow-arrow">→</span>
        <div class="flow-node">WhatsApp</div><span class="flow-arrow">→</span>
        <div class="flow-node">Lexie</div><span class="flow-arrow">→</span>
        <div class="flow-node">Agenda</div><span class="flow-arrow">→</span>
        <div class="flow-node">Confirmação</div><span class="flow-arrow">→</span>
        <div class="flow-node">CRM</div><span class="flow-arrow">→</span>
        <div class="flow-node">Relatórios</div>
      </div>
    </div>
  </section>

  <!-- SLOGAN BANNER -->
  <div class="slogan-banner reveal">
    <p><em>Inteligência</em> que conecta. <em>Resultados</em> que transformam.</p>
  </div>

  <!-- DESIRE / FEATURES -->
  <section id="recursos">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="eyebrow">O que a Lexie faz</div>
        <h2>Presença constante, não respostas prontas</h2>
        <p>Cada função abaixo resolve uma etapa real do atendimento — da primeira mensagem ao relatório financeiro do mês.</p>
      </div>

      <div class="feature-grid reveal">
        <div class="feature-card">
          <div class="feature-icon">◐</div>
          <h3 class="impact">Ela se adapta a como cada cliente gosta de conversar</h3>
          <p class="impact-sub">Se a pessoa manda áudio, ela responde em áudio. Se prefere mensagens curtas, é assim que ela fala. Da segunda conversa em diante, o atendimento já parece feito sob medida.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">▦</div>
          <h3 class="impact">Sua agenda para de ser um quebra-cabeça</h3>
          <p class="impact-sub">Nenhum horário duplicado, nenhuma marcação esquecida — cada vaga é preenchida sozinha, 24 horas por dia.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">◔</div>
          <h3 class="impact">Quem prefere ligar também sai com o horário marcado</h3>
          <p class="impact-sub">Nenhum cliente é perdido por preferir telefone a mensagem de texto — e você ainda recebe um resumo de cada chamada.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">◇</div>
          <h3>Financeiro</h3>
          <ul>
            <li>Envia cobrança</li>
            <li>Confirma pagamento</li>
            <li>Envia links de pagamento</li>
          </ul>
        </div>
        <div class="feature-card">
          <div class="feature-icon">◈</div>
          <h3 class="impact">Nenhuma informação se perde quando alguém esquece de anotar</h3>
          <p class="impact-sub">Tudo sobre cada cliente fica registrado automaticamente, pronto quando você precisar.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">◑</div>
          <h3 class="impact">Clientes que sumiriam no meio do caminho voltam sozinhos</h3>
          <p class="impact-sub">Ninguém esquece de confirmar, ninguém desiste por falta de um lembrete na hora certa.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- VOICE SPOTLIGHT -->
  <section id="ligacoes" style="padding-top:0;">
    <div class="wrap">
      <div class="voice-spotlight reveal">
        <div class="voice-spotlight-visual">
          <div class="call-card">
            <div class="call-avatar">L</div>
            <div class="call-name">Lexie</div>
            <div class="call-status">Chamada em andamento · 01:24</div>
            <div class="waveform"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
            <div class="call-confirm">Horário confirmado durante a ligação</div>
          </div>
        </div>
        <div class="voice-spotlight-text">
          <div class="voice-badge">Novidade no mercado</div>
          <h3>A Lexie também atende — e faz — ligações de verdade</h3>
          <p>Enquanto a maioria das automações trava no texto, a Lexie conduz uma chamada real: entende o que a pessoa fala, consulta a agenda e confirma um horário sem que ninguém precise digitar nada.</p>
          <ul class="voice-list">
            <li>Atende ligações recebidas pelo WhatsApp</li>
            <li>Faz ligações ativas quando necessário</li>
            <li>Agenda, remarca e confirma direto na chamada</li>
            <li>Envia um resumo da ligação automaticamente</li>
          </ul>
        </div>
      </div>

      <div class="proactive-call reveal">
        <div class="proactive-call-text">
          <h3>Quando um texto não basta, ela mesma sugere ligar</h3>
          <p>Se uma dúvida parece mais complicada do que um balão de mensagem consegue resolver, a Lexie propõe uma ligação rápida — porque atenção de verdade, às vezes, precisa de uma conversa de verdade.</p>
        </div>
        <div class="mini-chat">
          <div class="mini-bubble in">Não entendi direito como funciona o procedimento...</div>
          <div class="mini-bubble out">Posso te ligar rapidinho pra explicar melhor? Fica mais fácil tirar essa dúvida na conversa 🙂</div>
        </div>
      </div>
    </div>
  </section>
  <section style="padding-top:0;">
    <div class="wrap">
      <div class="handoff reveal">
        <div class="handoff-icon">◎</div>
        <div class="handoff-text">
          <h3>Ela sabe a hora de chamar alguém do seu time</h3>
          <p>A Lexie não insiste em resolver sozinha o que precisa de uma pessoa. Se o cliente pedir, ou se a situação exigir, ela mesma aciona o atendimento humano — com o histórico completo da conversa, sem o cliente precisar repetir nada.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- DIFERENCIAIS -->
  <section>
    <div class="wrap">
      <div class="section-head reveal">
        <div class="eyebrow">Por que a Lexie</div>
        <h2>O que muda no dia a dia do seu negócio</h2>
      </div>
      <div class="diff-list reveal">
        <div class="diff-item"><span class="diff-check">✓</span><span><strong>Atendimento 24 horas</strong> — nenhum cliente espera até segunda para ser respondido.</span></div>
        <div class="diff-item"><span class="diff-check">✓</span><span><strong>Nunca esquece informações</strong> — preferências e histórico ficam registrados automaticamente.</span></div>
        <div class="diff-item"><span class="diff-check">✓</span><span><strong>Escalável</strong> — atende 1 ou 100 conversas simultâneas com a mesma qualidade.</span></div>
        <div class="diff-item"><span class="diff-check">✓</span><span><strong>Padroniza o atendimento</strong> — todo cliente recebe o mesmo nível de cuidado na resposta.</span></div>
        <div class="diff-item"><span class="diff-check">✓</span><span><strong>Reduz custos operacionais</strong> — menos horas de atendimento manual em tarefas repetitivas.</span></div>
        <div class="diff-item"><span class="diff-check">✓</span><span><strong>Mais conversões</strong> — resposta imediata transforma mais contatos em venda ou agendamento.</span></div>
      </div>
    </div>
  </section>

  <!-- DASHBOARD -->
  <section>
    <div class="wrap">
      <div class="section-head reveal">
        <div class="eyebrow">Visibilidade total</div>
        <h2>Veja exatamente o que a Lexie está fazendo pelo seu negócio</h2>
        <p>Um painel simples com os números que importam — sem precisar entender de tecnologia.</p>
      </div>
      <div class="dash reveal">
        <div class="dash-inner">
          <div class="dash-top">
            <div class="dash-title">Visão geral — Vitalis</div>
            <div class="dash-period">26/06 — 03/07</div>
          </div>
          <div class="dash-grid">
            <div class="dash-card"><span>Atendimentos</span><b>412</b><span class="delta">↑ 18% vs. semana anterior</span></div>
            <div class="dash-card"><span>Conversões</span><b>131</b><span class="delta">↑ 24%</span></div>
            <div class="dash-card"><span>Taxa de conversão</span><b>31,8%</b><span class="delta">↑ 4,2pp</span></div>
            <div class="dash-card"><span>Tempo médio de resposta</span><b>2,1s</b><span class="delta">↓ 0,4s</span></div>
          </div>
          <div class="dash-chart">
            <div class="bar" style="height:45%"></div>
            <div class="bar" style="height:62%"></div>
            <div class="bar" style="height:38%"></div>
            <div class="bar" style="height:71%"></div>
            <div class="bar" style="height:55%"></div>
            <div class="bar" style="height:83%"></div>
            <div class="bar" style="height:67%"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section id="planos">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="eyebrow">Planos</div>
        <h2>Um nível para cada estágio do seu negócio</h2>
        <p>Comece pelo essencial e evolua conforme sua operação cresce — sem trocar de sistema.</p>
      </div>

      <div class="pricing-grid reveal">
        <div class="plan">
          <div class="plan-name">Starter</div>
          <div class="plan-desc">Automatize o atendimento inicial e os agendamentos.</div>
          <div class="plan-price">R$359<span>/mês</span></div>
          <hr>
          <ul class="plan-features">
            <li>Chat com clientes</li>
            <li>Agendamento e cancelamento via texto</li>
            <li>Lembretes automáticos</li>
            <li>Escalonamento simples para humano</li>
            <li>Salva preferências do cliente</li>
            <li>Controle manual de ativação</li>
          </ul>
          <a href="#faq" class="btn btn-ghost">Começar</a>
          <div class="plan-quota">Inclui até 60 conversas/mês</div>
        </div>

        <div class="plan featured">
          <div class="plan-badge">Mais escolhido</div>
          <div class="plan-name">Pro</div>
          <div class="plan-desc">Atendimento por ligação e inteligência de agenda.</div>
          <div class="plan-price">R$654<span>/mês</span></div>
          <hr>
          <ul class="plan-features">
            <li>Tudo do Starter, mais:</li>
            <li>Atendimento por ligação via WhatsApp</li>
            <li>Agendamento durante a chamada</li>
            <li>Resumo automático da ligação</li>
            <li>Regras avançadas de conflito</li>
            <li>Pesquisa de satisfação automática</li>
            <li>Chat privado do contratante</li>
          </ul>
          <a href="#faq" class="btn btn-primary">Começar</a>
          <div class="plan-quota">Inclui até 120 conversas/mês</div>
        </div>

        <div class="plan">
          <div class="plan-name">Business</div>
          <div class="plan-desc">Operação financeira e administrativa completa.</div>
          <div class="plan-price">R$989<span>/mês</span></div>
          <hr>
          <ul class="plan-features">
            <li>Tudo do Pro, mais:</li>
            <li>Ligações ativas e cobranças</li>
            <li>Links de pagamento e confirmação</li>
            <li>Relatórios financeiros</li>
            <li>Operação completa do CRM</li>
            <li>Leitura de e-mails e tarefas</li>
            <li>Histórico consolidado de ações</li>
          </ul>
          <a href="#faq" class="btn btn-ghost">Começar</a>
          <div class="plan-quota">Inclui até 180 conversas/mês</div>
        </div>

        <div class="plan">
          <div class="plan-name">Enterprise</div>
          <div class="plan-desc">Diagnóstico e implantação sob medida.</div>
          <div class="plan-price">Sob consulta</div>
          <hr>
          <ul class="plan-features">
            <li>Múltiplas equipes e unidades</li>
            <li>Integração com sistema próprio</li>
            <li>CRM e fluxos personalizados</li>
            <li>Treinamento da IA sob medida</li>
            <li>Implantação dedicada</li>
          </ul>
          <a href="#faq" class="btn btn-ghost">Solicitar diagnóstico</a>
        </div>
      </div>
    </div>
  </section>

  <!-- SOCIAL PROOF -->
  <section>
    <div class="wrap">
      <div class="proof-row reveal">
        <div class="proof-logo">VITALIS SAÚDE</div>
